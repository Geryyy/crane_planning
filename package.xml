<?xml version="1.0"?>
<package format="3">
  <name>crane_planning</name>
  <version>0.1.0</version>
  <description>The `crane_planner` node: an OMPL geometric search over the five
    planned joint coordinates, a C2 fit, and one CasADi/IPOPT optimal control
    problem that decides how fast the path may be traversed. Provides
    `/crane/plan_motion`; grip motion is owned by
    concrete_block_motion_planning.</description>
  <maintainer email="maintainers@example.invalid">Architecture maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Everything the machine can do (reach, hang, collide, lift) is asked of
       this package. No geometry and no constant is restated here; the OCP is
       assembled from `crane_model.symbolic`'s own CasADi graph. -->
  <depend>crane_model</depend>
  <depend>crane_msgs</depend>
  <!-- The optimal control problem of wiki/trajectory_planning.md 5.2, written
       once and solved with IPOPT. libraries.md 1 lists CasADi for exactly this;
       no NLP is written by hand. -->
  <depend>casadi</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>trajectory_msgs</depend>
  <!-- The plan, drawn: the path, the tool swept along it, the goal, and the
       bodies the plan was checked against. -->
  <depend>visualization_msgs</depend>
  <!-- The retained `a2b_movement` contract (`CalcMovement.srv`) and the message
       package its payload fields are made of. These are retained-tree interface
       packages, not new third-party dependencies: they are the `.srv` and
       `.msg` definitions the timber stack already ships, and serving them is
       what makes this node a drop-in replacement for the legacy A2B planner.
       `wood_log_msgs` is named although no import here reaches it directly,
       because `CalcMovement` embeds `LogShape` and `Log[]` and an interface
       dependency that is only transitive is one a manifest walk cannot see. -->
  <depend>timber_crane_planning_interfaces</depend>
  <depend>wood_log_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <!-- `scripts/plan_example.py` alone; the node draws nothing. -->
  <exec_depend>python3-matplotlib</exec_depend>

  <!-- `test/` asserts that the truck expansion covers the posts and the headboard the
       description actually carries; it needs the YAML the node is launched with. -->
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
